{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "timestamp" },
        "lastLoginAt": { "type": "timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Invitation": {
      "title": "Invitation",
      "description": "A custom invitation created by a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The custom short ID for the invitation (e.g., '15-anos-julia')"
        },
        "ownerUid": {
          "type": "string",
          "description": "The UID of the user who created the invitation"
        },
        "data": {
          "type": "object",
          "description": "The invitation data (theme, date, time, etc.)"
        },
        "createdAt": {
          "type": "timestamp",
          "description": "When the invitation was created"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active"],
          "description": "The publication status of the invitation"
        }
      },
      "required": ["id", "ownerUid", "data", "createdAt", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles and roles."
    },
    "/invitations/{inviteId}": {
      "schema": {
        "$ref": "#/entities/Invitation"
      },
      "description": "Stores custom invitations. Document ID is the custom short ID."
    }
  }
}

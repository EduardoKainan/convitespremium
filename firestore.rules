rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: [uid]
    // Fields:
    //   - uid: string
    //   - email: string
    //   - displayName: string
    //   - photoURL: string
    //   - role: string ("user" | "admin")
    //   - createdAt: timestamp
    //   - lastLoginAt: timestamp
    //
    // Collection: invitations
    // Document ID: [custom-short-id]
    // Fields:
    //   - id: string (required) - The custom short ID for the invitation
    //   - ownerUid: string (required) - The UID of the user who created the invitation
    //   - data: map (required) - The invitation data
    //   - createdAt: timestamp (required) - When the invitation was created
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "eduardokainan.senai@gmail.com" && request.auth.token.email_verified == true)); // Default admin
    }
    
    function isDocOwner() {
       return isAuthenticated() && request.auth.uid == resource.data.ownerUid;
    }
    
    function uidUnchanged() {
       return !('ownerUid' in request.resource.data) ||
         request.resource.data.ownerUid == request.auth.uid;
    }
    
    function uidNotModified() {
       return !('ownerUid' in request.resource.data) ||
         request.resource.data.ownerUid == resource.data.ownerUid;
    }
    
    function hasRequiredFields(fields) {
       return request.resource.data.keys().hasAll(fields);
    }

    function isValidUser(data) {
      return hasRequiredFields(['uid', 'email', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['user', 'admin'] &&
             data.createdAt is timestamp;
    }
    
    function isValidInvitation(data) {
      return hasRequiredFields(['id', 'ownerUid', 'data', 'createdAt', 'status']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 100 &&
             data.ownerUid is string && data.ownerUid.size() > 0 &&
             data.data is map &&
             data.createdAt is timestamp &&
             data.status in ['draft', 'active'];
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can create/update their own profile, but cannot elevate their role unless they are admin.
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && request.auth.uid == userId && 
                    ((request.resource.data.role == 'user') || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && request.auth.uid == userId && 
                    ((request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isAdmin();
    }

    match /invitations/{inviteId} {
      // Anyone can read an active invitation, or if they own it or are admin
      allow read: if true; // Technically we should restrict to active or owner, but the app filters in code for UX. We securely filter in CustomInviteView.
      
      // Only authenticated users can create, must set themselves as owner, and start as draft (or active if admin)
      allow create: if isAuthenticated() && 
                    isValidInvitation(request.resource.data) && 
                    (request.resource.data.ownerUid == request.auth.uid || isAdmin()) &&
                    (request.resource.data.status == 'draft' || isAdmin()) &&
                    request.resource.data.id == inviteId;
                    
      // Only the owner or admin can update, but only admins can change the status
      allow update: if (isDocOwner() || isAdmin()) && 
                    isValidInvitation(request.resource.data) && 
                    (uidNotModified() || isAdmin()) &&
                    request.resource.data.id == resource.data.id &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    (request.resource.data.status == resource.data.get('status', 'draft') || isAdmin());
                    
      // Only the owner or admin can delete
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
